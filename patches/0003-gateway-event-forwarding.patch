+export function shouldDivertForBackpressure(bufferedAmount) {
+  return typeof bufferedAmount === 'number'
+    && Number.isFinite(bufferedAmount)
+    && bufferedAmount > MAX_CLIENT_BUFFER_BYTES;
+}
