{
  "name": "dsh-mobile-access",
  "version": "1.16.2",
  "description": "把 DSH 变成手机可用的远程终端：带鉴权的移动网关（设备配对、会话流式中继、审批、交付物、Runbook），手机扫码即连，不暴露 3080。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "public",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "ccleeyx",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "android",
    "remote-access",
    "gateway"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccleeyx-cyber/dsh-mobile.git",
    "directory": "dsh-server-plugin"
  },
  "homepage": "https://github.com/ccleeyx-cyber/dsh-mobile/tree/main/dsh-server-plugin",
  "bugs": {
    "url": "https://github.com/ccleeyx-cyber/dsh-mobile/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "yaml": "^2.9.1"
  },
  "dsh": {
    "name": "手机远程访问（DSH Mobile Bridge）",
    "category": "tools",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}

