<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.dsh_mobile">

    <!-- 联网权限 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- 触觉反馈与震动权限 (HapticFeedback) -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- 语音输入（系统语音识别，§4.2） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 语音识别需要查询设备上是否存在语音服务；在 Android 11+ 这也是必须的 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>

    <!-- 通知（§4.2 推送通知）。
         Android 13 (API 33) 起必须由用户显式授权，否则通知不显示；
         旧版本由系统自动放行，所以要同时声明 maxSdkVersion 以免多要权限。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 前台服务：让 WebSocket 在 App 退到后台后仍保持连接。
         Android 9+ 限制后台启动服务，Android 14 (API 34) 起还必须声明
         foregroundServiceType 且类型要与你实际做的事一致。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- 息屏后仍要收到推送，需要绕过 Doze 的省电限制 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- 允许非加密明文流量(ws:// 和 http://)，方便公网 IP 直接连接。
         allowBackup=false：网关令牌存在 SharedPreferences 里，云备份会把它
         带走（Android 12+ 云备份默认开启）。-->
    <application
        android:label="DSH Mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 分享接收：从任意 App 分享文字/图片直接进 DSH 发送框。
                 文字进输入框；图片走既有的附件管线（压缩→内联 base64）。 -->
            <intent-filter android:label="发送到 DSH">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter android:label="发送到 DSH">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>

            <!-- 深链接：离线推送（ntfy）点开后直达对应会话。
                 没有这个 filter，用户点开推送只会落到浏览器，等于白推。 -->
            <intent-filter android:label="打开 DSH 会话">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="dshmobile"/>
            </intent-filter>
        </activity>

        <!-- 交付物/文件的外发通道。Android 7+ 禁止直接传 file://，
             必须由 FileProvider 授权缓存目录里的文件。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 后台保活前台服务：进程被系统回收后由系统重建（START_STICKY），
             否则 WebSocket 随进程一起消失，后台推送就永远不会发生。
             foregroundServiceType 必须与 build.gradle/代码里 startForeground
             传入的类型一致，否则 Android 10+ 会抛 IllegalStateException。 -->
        <service
            android:name=".GatewayKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 推送通道：低重要性（默认渠道），避免每次事件都弹出横幅打断操作。
             高重要性渠道只在用户主动开启"重要提醒"时使用。 -->
        <meta-data
            android:name="com.example.dsh_mobile.NOTIFICATION_CHANNEL_ID"
            android:value="dsh_events" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>