# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Android
**/*.apk
**/*.aab
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
.gradle/

# IDE
.idea/
.vscode/
*.iml
cookie.txt

# Agent orchestration scratch — contains sub-agent transcripts with live
# tokens (GitHub PATs, bridge tokens, engine secrets). Never commit.
# NOTE: `.agents/hooks.json` was committed before this rule existed; gitignore
# has no effect on already-tracked files. It was untracked again on 2026-10-08
# via `git rm --cached`. Do not re-add anything under .agents/.
.agents/

# Superseded implementation kept only for reference.
# Deleted from disk on 2026-10-08: it still contained a plaintext engine HMAC
# secret and a live bridge token, and nothing imported it. Rule kept so it can
# never be re-committed by accident.
dsh-server-plugin/index.js.legacy

# Local environment overrides
.env
.env.local
*.local

# Android signing material — never commit the keystore or its passwords.
*.jks
*.keystore
key.properties

# Test leftovers
_diag*.log
_run*.log
_u.log
_t.log
# scripts/await-apk.mjs writes the downloaded CI artifact here and never cleans up.
apk-artifact.zip

# 一次性排查脚本（probe/verify-*）。都是为某个具体问题临时写的探针，跑完即弃，
# 没有文档也没有维护价值 —— 曾经有 18 个躺在工作区里，其中 17 个未跟踪、1 个
# （download-e2e.mjs）被跟踪，没有任何规则解释这个区别。
#
# 例外保留 download-e2e.mjs：它是"无需重启就能做的端到端验证"（真实 HTTP server +
# 真实分发器），历史上由 patches/README.md 记载（该目录 2026-10-17 已删除）。
.probe/*
!.probe/download-e2e.mjs
# The E2E memory tests write these into whatever workspacePath they are pointed
# at. On 2026-10-08 they were found in E:\workspace\个人\ — i.e. OUTSIDE this
# repo, where gitignore cannot reach them. The real fix is to point those tests
# at a temp dir (guard.js 现在就是这么做的，见 docs/TESTING.md); these rules only
# cover the case where the repo itself is the workspace.
E2E_MEMORY_TEST.MD
LARGE_MEMORY_TEST.MD
PROJECT_WORKLOAD_MEMORY.MD
